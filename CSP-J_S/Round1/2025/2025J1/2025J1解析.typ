== 

```cpp
#include <cstdio>
#include <cstring>
#include <algorithm>
inline int gcd(int a, int b) {
  if (b == 0)
    return a;
  return gcd(b, a % b);
}
int main() {
  int n;
  scanf("%d", &n);
  int ans = 0;
  for (int i = 1; i <= n; ++i) {
    for (int j = i + 1; j <= n; ++j) {
      for (int k = j + 1; k <= n; ++k) {
        if (gcd(i, j) == 1 && gcd(j, k) == 1 && gcd(i, k) == 1) {
          ++ans;
        }
      }
    }
  }
  printf("%d\n", ans);
  return 0;
}
```

*代码含义解析*：
三重循环枚举`i,j,k`，统计 `i,j`互质、`j,k`互质、`i,k`互质的三元组组数。


