=== 参考程序

```cpp
#include <cstdio>
#include <algorithm>
using namespace std;
const int N = 2005;
const int mod = 1e9;
int n;
char s[N];
int f[N][N];
int main() {
    scanf("%d", &n);
    scanf("%s", s + 1);
    f[0][0] = 1;
    for (int i = 1; i <= n; i++)
        for (int j = 0; j <= n; j++) {
            f[i][j] = f[i - 1][j];
            if (s[i] == '(' && j)
                f[i][j] = (f[i][j] + f[i - 1][j - 1]) % mod;
            if (s[i] == ')' && j < n)
                f[i][j] = (f[i][j] + f[i - 1][j + 1]) % mod;
        }
    printf("%d\n", f[n][0]);
    return 0;
}9 / 9
```

